{
  "manifest_version": 2,
  "name": "STG Native Tab Groups Fix",
  "version": "1.0.0",
  "description": "Убирает пустые плашки (синие квадраты) нативных групп вкладок Firefox при переключении групп в Simple Tab Groups и восстанавливает их при возврате.",
  "author": "Oleg",
  "browser_specific_settings": {
    "gecko": {
      "id": "stg-native-groups-fix@olegius.org",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "tabs",
    "tabGroups",
    "sessions"
  ],
  "browser_action": {
    "default_icon": "icons/icon.svg",
    "default_title": "STG Native Tab Groups Fix",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
